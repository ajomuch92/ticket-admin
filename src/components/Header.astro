---
import { ChevronDown, Sun, Moon, User, LogOut, Menu } from "@lucide/astro";

interface Props {
    title?: string;
    nombre?: string;
    email?: string;
}

const { title = "Dashboard", nombre = "Usuario", email = "" } = Astro.props;
const initials = nombre.trim().substring(0, 2).toUpperCase() || "US";
---

<header
    class="bg-body border-bottom d-flex align-items-center justify-content-between px-3 px-md-4 position-sticky top-0"
    style="height: 64px; z-index: 10"
>
    <div class="d-flex align-items-center gap-2" style="min-width: 0">
        <button
            type="button"
            data-sidebar-toggle
            class="btn btn-outline-secondary d-lg-none d-flex align-items-center justify-content-center p-0 flex-shrink-0"
            style="width: 36px; height: 36px"
            aria-label="Abrir menú"
        >
            <Menu width="20" height="20" stroke-width="2" />
        </button>
        <h1 class="fs-5 fw-semibold m-0 text-truncate">{title}</h1>
    </div>

    <div class="d-flex align-items-center gap-2 gap-md-3">
        <button
            type="button"
            data-theme-toggle
            class="btn btn-outline-secondary d-flex align-items-center justify-content-center p-0"
            style="width: 36px; height: 36px"
            aria-label="Cambiar tema"
        >
            <Sun class="theme-icon-sun" width="18" height="18" stroke-width="2" />
            <Moon
                class="theme-icon-moon"
                width="18"
                height="18"
                stroke-width="2"
                style="display: none"
            />
        </button>

        <div class="dropdown">
            <button
                type="button"
                data-dropdown-toggle
                class="btn d-flex align-items-center gap-2 p-1 pe-3 rounded border-0"
            >
                <div
                    class="d-flex align-items-center justify-content-center rounded fw-bold text-primary"
                    style="width: 36px; height: 36px; font-size: 14px; background-color: rgba(13, 110, 253, 0.1)"
                >
                    {initials}
                </div>
                <div class="d-none d-sm-flex flex-column text-start">
                    <span class="fw-semibold lh-1" style="font-size: 14px"
                        >{nombre}</span
                    >
                    <span class="text-muted lh-1 mt-1" style="font-size: 12px"
                        >{email}</span
                    >
                </div>
                <ChevronDown
                    class="text-muted"
                    width="16"
                    height="16"
                    stroke-width="2"
                />
            </button>

            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a
                        class="dropdown-item d-flex align-items-center gap-2"
                        href="/dashboard/perfil"
                    >
                        <User width="16" height="16" stroke-width="2" />
                        Perfil
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <a
                        class="dropdown-item d-flex align-items-center gap-2 text-danger"
                        href="/login?action=logout"
                    >
                        <LogOut width="16" height="16" stroke-width="2" />
                        Cerrar sesión
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>

<script>
    // Dropdown sin Bootstrap JS: toggle de .show + cierre al clicar fuera.
    const toggle = document.querySelector("[data-dropdown-toggle]");
    const menu = toggle?.nextElementSibling;
    toggle?.addEventListener("click", (e) => {
        e.stopPropagation();
        menu?.classList.toggle("show");
    });
    document.addEventListener("click", () => menu?.classList.remove("show"));
</script>
