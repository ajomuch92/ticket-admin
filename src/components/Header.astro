---
import { Bell, ChevronDown } from "@lucide/astro";

interface Props {
    title?: string;
}

const { title = "Dashboard" } = Astro.props;
---

<header
    class="h:64 bg:white border-b:1|solid|gray-20 d:flex ai:center jc:space-between px:24 sticky top:0 z:10"
>
    <h1 class="text:20 font:semibold text:gray-90 m:0">{title}</h1>

    <div class="d:flex ai:center gap:16">
        <button
            class="bg:transparent border:none cursor:pointer d:flex ai:center jc:center w:36 h:36 r:8 hover:bg:gray-10 transition:all|0.2s text:gray-60"
        >
            <Bell width="20" height="20" stroke-width="2" />
        </button>

        <div class="w:1 h:24 bg:gray-20"></div>

        <div
            class="d:flex ai:center gap:12 cursor:pointer p:4 pr:12 r:8 hover:bg:gray-5 transition:all|0.2s"
        >
            <div
                class="w:36 h:36 bg:#0984e3|10 text:#0984e3 d:flex ai:center jc:center r:8 font:bold text:14"
            >
                AD
            </div>
            <div class="d:flex flex:col">
                <span class="text:14 font:semibold text:gray-90 lh:1"
                    >Admin User</span
                >
                <span class="text:12 text:gray-50 lh:1 mt:4"
                    >admin@ejemplo.com</span
                >
            </div>
            <ChevronDown
                class="text:gray-40"
                width="16"
                height="16"
                stroke-width="2"
            />
        </div>
    </div>
</header>
