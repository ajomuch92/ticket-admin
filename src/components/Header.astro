---
import { ChevronDown, Sun, Moon } from "@lucide/astro";

interface Props {
    title?: string;
}

const { title = "Dashboard" } = Astro.props;
---

<header
    class="bg-body border-bottom d-flex align-items-center justify-content-between px-4 position-sticky top-0"
    style="height: 64px; z-index: 10"
>
    <h1 class="fs-5 fw-semibold m-0">{title}</h1>

    <div class="d-flex align-items-center gap-3">
        <button
            type="button"
            data-theme-toggle
            class="btn btn-outline-secondary d-flex align-items-center justify-content-center p-0"
            style="width: 36px; height: 36px"
            aria-label="Cambiar tema"
        >
            <Sun class="theme-icon-sun" width="18" height="18" stroke-width="2" />
            <Moon
                class="theme-icon-moon"
                width="18"
                height="18"
                stroke-width="2"
                style="display: none"
            />
        </button>

        <div
            class="d-flex align-items-center gap-2 p-1 pe-3 rounded"
            style="cursor: pointer"
        >
            <div
                class="d-flex align-items-center justify-content-center rounded fw-bold text-primary"
                style="width: 36px; height: 36px; font-size: 14px; background-color: rgba(13, 110, 253, 0.1)"
            >
                AD
            </div>
            <div class="d-flex flex-column">
                <span class="fw-semibold lh-1" style="font-size: 14px"
                    >Admin User</span
                >
                <span class="text-muted lh-1 mt-1" style="font-size: 12px"
                    >admin@ejemplo.com</span
                >
            </div>
            <ChevronDown
                class="text-muted"
                width="16"
                height="16"
                stroke-width="2"
            />
        </div>
    </div>
</header>
