---
import {
    LayoutDashboard,
    Ticket,
    Users,
    Shield,
    Lock,
    Activity,
    Flag,
    LogOut,
} from "@lucide/astro";

const pathname = new URL(Astro.request.url).pathname;

const menuItems = [
    { name: "Dashboard", path: "/dashboard", Icon: LayoutDashboard },
    { name: "Tickets", path: "/dashboard/tickets", Icon: Ticket },
    { name: "Usuarios", path: "/dashboard/usuarios", Icon: Users },
    { name: "Roles", path: "/dashboard/roles", Icon: Shield },
    { name: "Permisos", path: "/dashboard/permisos", Icon: Lock },
    { name: "Estados", path: "/dashboard/estados", Icon: Activity },
    { name: "Prioridades", path: "/dashboard/prioridades", Icon: Flag },
];
---

<aside
    class="bg-white border-end d-flex flex-column vh-100 position-sticky top-0"
    style="width: 250px"
>
    <div
        class="d-flex align-items-center px-3 border-bottom"
        style="height: 64px"
    >
        <Ticket class="me-2 text-primary" width="24" height="24" stroke-width="2" />
        <span class="fs-5 fw-bold"
            >Ticket<span class="text-primary">Admin</span></span
        >
    </div>

    <nav class="flex-grow-1 overflow-auto py-3 px-2 d-flex flex-column gap-1">
        {
            menuItems.map((item) => {
                const isActive =
                    pathname === item.path ||
                    (item.path !== "/dashboard" &&
                        pathname.startsWith(item.path));
                return (
                    <a
                        href={item.path}
                        class={`side-link d-flex align-items-center px-3 py-2 rounded text-decoration-none fw-medium ${isActive ? "active" : ""}`}
                    >
                        <item.Icon
                            class="me-3"
                            width="20"
                            height="20"
                            stroke-width="2"
                        />
                        {item.name}
                    </a>
                );
            })
        }
    </nav>

    <div class="p-3 border-top">
        <div class="text-uppercase small fw-semibold text-secondary mb-2 px-2">
            Sistema
        </div>
        <a
            href="/login?action=logout"
            class="side-link side-link-danger d-flex align-items-center px-3 py-2 rounded text-decoration-none fw-medium"
        >
            <LogOut class="me-3" width="20" height="20" stroke-width="2" />
            Cerrar sesión
        </a>
    </div>
</aside>

<style>
    .side-link {
        color: #6c757d;
        transition: all 0.15s ease-in-out;
    }
    .side-link:hover {
        background-color: #f1f3f5;
        color: #212529;
    }
    .side-link.active {
        background-color: rgba(13, 110, 253, 0.1);
        color: #0d6efd;
    }
    .side-link-danger:hover {
        background-color: rgba(220, 53, 69, 0.1);
        color: #dc3545;
    }
</style>
