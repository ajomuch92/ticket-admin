---
import {
    LayoutDashboard,
    Ticket,
    Users,
    Shield,
    Lock,
    Activity,
    Flag,
    LogOut,
} from "@lucide/astro";

const pathname = new URL(Astro.request.url).pathname;

const menuItems = [
    { name: "Dashboard", path: "/dashboard", Icon: LayoutDashboard },
    { name: "Tickets", path: "/dashboard/tickets", Icon: Ticket },
    { name: "Usuarios", path: "/dashboard/usuarios", Icon: Users },
    { name: "Roles", path: "/dashboard/roles", Icon: Shield },
    { name: "Permisos", path: "/dashboard/permisos", Icon: Lock },
    { name: "Estados", path: "/dashboard/estados", Icon: Activity },
    { name: "Prioridades", path: "/dashboard/prioridades", Icon: Flag },
];
---

<aside
    class="w:250 bg:white border-r:1|solid|gray-20 d:flex flex:col h:100vh sticky top:0"
>
    <div class="h:64 d:flex ai:center px:20 border-b:1|solid|gray-20">
        <Ticket
            class="mr:8 text:#0984e3"
            width="24"
            height="24"
            stroke-width="2"
        />
        <span class="font:18 font:bold text:gray-90"
            >Ticket<span class="text:#0984e3">Admin</span></span
        >
    </div>

    <nav class="flex:1 overflow-y:auto py:16 px:12 d:flex flex:col gap:4">
        {
            menuItems.map((item) => {
                const isActive =
                    pathname === item.path ||
                    (item.path !== "/dashboard" &&
                        pathname.startsWith(item.path));
                return (
                    <a
                        href={item.path}
                        class={`d:flex ai:center px:12 py:10 r:8 text:14 font:medium text-decoration:none transition:all|0.2s ${isActive ? "bg:#0984e3|10 text:#0984e3" : "text:gray-60 hover:bg:gray-10 hover:text:gray-90"}`}
                    >
                        <item.Icon
                            class={`mr:12 ${isActive ? "text:#0984e3" : "text:gray-50"}`}
                            width="20"
                            height="20"
                            stroke-width="2"
                        />
                        {item.name}
                    </a>
                );
            })
        }
    </nav>

    <div class="p:16 border-t:1|solid|gray-20">
        <div class="text:12 text:gray-50 font:medium mb:8 px:8">SISTEMA</div>
        <a
            href="/login?action=logout"
            class="d:flex ai:center px:12 py:10 r:8 text:14 font:medium text-decoration:none text:gray-60 hover:bg:red-5 hover:text:red-60 transition:all|0.2s"
        >
            <LogOut
                class="mr:12 text:gray-50"
                width="20"
                height="20"
                stroke-width="2"
            />
            Cerrar sesión
        </a>
    </div>
</aside>
