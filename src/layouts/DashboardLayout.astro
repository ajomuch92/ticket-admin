---
import Layout from './Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';

interface Props {
    title?: string;
    pageTitle?: string;
}

const { title = "Dashboard", pageTitle } = Astro.props;
---

<Layout title={`${title} | Ticket Admin`}>
    <div class="d-flex min-vh-100 w-100 bg-light">
        <Sidebar />

        <main class="flex-grow-1 d-flex flex-column" style="min-width: 0">
            <Header title={pageTitle || title} />

            <div class="p-4 flex-grow-1 overflow-auto">
                <div class="mx-auto w-100" style="max-width: 1200px">
                    <slot />
                </div>
            </div>
        </main>
    </div>
</Layout>
