---
interface Props {
    title?: string;
}

const { title = "Ticket Admin" } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
            crossorigin="anonymous"
        />
        <!-- Aplica el tema antes de pintar (evita flash). is:inline = no bundled. -->
        <script is:inline>
            (() => {
                const saved = localStorage.getItem("theme");
                const theme =
                    saved ||
                    (matchMedia("(prefers-color-scheme: dark)").matches
                        ? "dark"
                        : "light");
                document.documentElement.setAttribute("data-bs-theme", theme);
            })();
        </script>
    </head>
    <body class="bg-body-tertiary d-flex flex-column min-vh-100">
        <slot />
    </body>
</html>

<script>
    // Toggle de tema. Delegado: cualquier [data-theme-toggle] en la página sirve.
    function syncThemeIcons() {
        const dark =
            document.documentElement.getAttribute("data-bs-theme") === "dark";
        document
            .querySelectorAll(".theme-icon-sun")
            .forEach((e) => ((e as HTMLElement).style.display = dark ? "" : "none"));
        document
            .querySelectorAll(".theme-icon-moon")
            .forEach((e) => ((e as HTMLElement).style.display = dark ? "none" : ""));
    }
    syncThemeIcons();

    document.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement)?.closest("[data-theme-toggle]");
        if (!btn) return;
        const dark =
            document.documentElement.getAttribute("data-bs-theme") === "dark";
        const next = dark ? "light" : "dark";
        document.documentElement.setAttribute("data-bs-theme", next);
        localStorage.setItem("theme", next);
        syncThemeIcons();
    });

    // Sidebar como drawer en móvil: hamburguesa abre, backdrop/link cierra.
    // El transform se setea inline (la regla CSS con combinador no gana en este
    // motor por un quirk de cascada); backdrop se controla con la clase del body.
    function setSidebar(open: boolean) {
        const sidebar = document.querySelector<HTMLElement>(".sidebar");
        document.body.classList.toggle("sidebar-open", open);
        if (!sidebar) return;
        if (open) sidebar.style.setProperty("transform", "translateX(0)", "important");
        else sidebar.style.removeProperty("transform");
    }
    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target?.closest("[data-sidebar-toggle]")) {
            setSidebar(!document.body.classList.contains("sidebar-open"));
        } else if (
            target?.closest("[data-sidebar-close]") ||
            target?.closest(".sidebar a")
        ) {
            setSidebar(false);
        }
    });
</script>

<style is:global>
    /* Reserva del scrollbar para evitar saltos horizontales al navegar. */
    html {
        scrollbar-gutter: stable;
    }

    /* Bootstrap 5.0.2 no trae estos pesos como utilidades. */
    .fw-medium {
        font-weight: 500 !important;
    }
    .fw-semibold {
        font-weight: 600 !important;
    }

    /* Sidebar: columna fija en desktop; drawer deslizable en < lg. */
    .sidebar {
        width: 250px;
        height: 100vh;
        position: sticky;
        top: 0;
    }
    .sidebar-backdrop {
        display: none;
    }
    @media (max-width: 991.98px) {
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1045;
            transform: translateX(-100%);
            transition: transform 0.2s ease-in-out;
        }
        body.sidebar-open .sidebar {
            transform: translateX(0) !important;
        }
        body.sidebar-open .sidebar-backdrop {
            display: block;
            position: fixed;
            inset: 0;
            z-index: 1044;
            background: rgba(0, 0, 0, 0.5);
        }
    }
</style>
