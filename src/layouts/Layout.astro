---
interface Props {
    title?: string;
}

const { title = "Ticket Admin" } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
            crossorigin="anonymous"
        />
        <!-- Aplica el tema antes de pintar (evita flash). is:inline = no bundled. -->
        <script is:inline>
            (() => {
                const saved = localStorage.getItem("theme");
                const theme =
                    saved ||
                    (matchMedia("(prefers-color-scheme: dark)").matches
                        ? "dark"
                        : "light");
                document.documentElement.setAttribute("data-bs-theme", theme);
            })();
        </script>
    </head>
    <body class="bg-body-tertiary d-flex flex-column min-vh-100">
        <slot />
    </body>
</html>

<script>
    // Toggle de tema. Delegado: cualquier [data-theme-toggle] en la página sirve.
    function syncThemeIcons() {
        const dark =
            document.documentElement.getAttribute("data-bs-theme") === "dark";
        document
            .querySelectorAll(".theme-icon-sun")
            .forEach((e) => ((e as HTMLElement).style.display = dark ? "" : "none"));
        document
            .querySelectorAll(".theme-icon-moon")
            .forEach((e) => ((e as HTMLElement).style.display = dark ? "none" : ""));
    }
    syncThemeIcons();

    document.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement)?.closest("[data-theme-toggle]");
        if (!btn) return;
        const dark =
            document.documentElement.getAttribute("data-bs-theme") === "dark";
        const next = dark ? "light" : "dark";
        document.documentElement.setAttribute("data-bs-theme", next);
        localStorage.setItem("theme", next);
        syncThemeIcons();
    });
</script>

<style is:global>
    /* Reserva del scrollbar para evitar saltos horizontales al navegar. */
    html {
        scrollbar-gutter: stable;
    }

    /* Bootstrap 5.0.2 no trae estos pesos como utilidades. */
    .fw-medium {
        font-weight: 500 !important;
    }
    .fw-semibold {
        font-weight: 600 !important;
    }
</style>
