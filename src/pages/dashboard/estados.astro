---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { Plus, SquarePen } from "@lucide/astro";

// Datos simulados
const estados = [
    { id: 1, nombre: "Abierto", orden: 1, color: "blue" },
    { id: 2, nombre: "En Progreso", orden: 2, color: "orange" },
    { id: 3, nombre: "Resuelto", orden: 3, color: "green" },
    { id: 4, nombre: "Cerrado", orden: 4, color: "gray" },
];

const badgeClass = (c: string) =>
    ({
        blue: "bg-primary",
        orange: "bg-warning text-dark",
        green: "bg-success",
        red: "bg-danger",
        gray: "bg-secondary",
    })[c] ?? "bg-secondary";
---

<DashboardLayout pageTitle="Gestión de Estados">
    <div class="card">
        <div class="card-header bg-white d-flex align-items-center justify-content-end">
            <button class="btn btn-primary d-flex align-items-center gap-2">
                <Plus width="16" height="16" stroke-width="2" />
                Nuevo Estado
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-uppercase small text-secondary">ID</th>
                        <th class="text-uppercase small text-secondary">Estado</th>
                        <th class="text-uppercase small text-secondary text-center">
                            Orden
                        </th>
                        <th class="text-uppercase small text-secondary text-end">
                            Acciones
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {
                        estados.map((estado) => (
                            <tr>
                                <td class="text-secondary fw-medium">
                                    #{estado.id}
                                </td>
                                <td>
                                    <span class={`badge ${badgeClass(estado.color)}`}>
                                        {estado.nombre}
                                    </span>
                                </td>
                                <td class="fw-semibold text-secondary text-center">
                                    {estado.orden}
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-link text-secondary p-1">
                                        <SquarePen width="18" height="18" stroke-width="2" />
                                    </button>
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </div>
</DashboardLayout>
