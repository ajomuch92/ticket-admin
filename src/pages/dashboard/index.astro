---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { actions } from "astro:actions";
import { Ticket, Clock, CircleCheck, Users } from "@lucide/astro";

const { data } = await Astro.callAction(actions.dashboard.stats, {});
const stats = data ?? {
    totalTickets: 0,
    usuariosActivos: 0,
    porEstado: [],
    porPrioridad: [],
    actividadReciente: [],
};

// ponytail: cards "Abiertos"/"Resueltos" salen por match de nombre del estado
// (heurística). Si renombras estados, ajusta los regex o cambia a datos por-estado.
const countEstado = (re: RegExp) =>
    stats.porEstado.find((e) => re.test(e.nombre))?.count ?? 0;

const summaryCards = [
    { title: "Tickets Totales", value: stats.totalTickets, Icon: Ticket, color: "#0984e3" },
    { title: "Tickets Abiertos", value: countEstado(/abiert/i), Icon: Clock, color: "#e17055" },
    { title: "Tickets Resueltos", value: countEstado(/resuel|cerrad/i), Icon: CircleCheck, color: "#00b894" },
    { title: "Usuarios Activos", value: stats.usuariosActivos, Icon: Users, color: "#6c5ce7" },
];

const barColors = ["bg-danger", "bg-warning", "bg-primary", "bg-success", "bg-info", "bg-secondary"];
const maxPrioridad = Math.max(1, ...stats.porPrioridad.map((p) => p.count));

const fmtFecha = (f: unknown) =>
    f ? new Date(f as string).toLocaleString("es-ES", { dateStyle: "short", timeStyle: "short" }) : "—";
---

<DashboardLayout pageTitle="Resumen General">
    <div class="row g-3 mb-4">
        {
            summaryCards.map((card) => (
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="small fw-medium text-muted m-0 mb-2">
                                    {card.title}
                                </h3>
                                <p class="fs-3 fw-bold m-0">{card.value}</p>
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-center rounded"
                                style={`width: 48px; height: 48px; background-color: ${card.color}15; color: ${card.color};`}
                            >
                                <card.Icon width="24" height="24" stroke-width="2" />
                            </div>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>

    <div class="row g-3">
        <!-- Panel 1: Actividad Reciente -->
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div
                    class="card-header bg-body d-flex align-items-center justify-content-between"
                >
                    <h2 class="fs-6 fw-semibold m-0">Actividad Reciente</h2>
                    <a
                        href="/dashboard/tickets"
                        class="small text-primary text-decoration-none fw-medium"
                        >Ver todos</a
                    >
                </div>
                <div class="list-group list-group-flush">
                    {
                        stats.actividadReciente.length === 0 ? (
                            <div class="list-group-item text-center text-muted py-4">
                                Sin actividad
                            </div>
                        ) : (
                            stats.actividadReciente.map((t) => (
                                <div class="list-group-item d-flex align-items-center px-3 py-3">
                                    <div
                                        class="bg-body-tertiary rounded d-flex align-items-center justify-content-center me-3 flex-shrink-0"
                                        style="width: 32px; height: 32px"
                                    >
                                        <span class="small fw-bold text-secondary">
                                            #{t.id}
                                        </span>
                                    </div>
                                    <div class="flex-grow-1" style="min-width: 0">
                                        <p class="fw-medium m-0 text-truncate">
                                            {t.titulo}
                                        </p>
                                        <p class="small text-muted m-0">
                                            {fmtFecha(t.fecha)}
                                        </p>
                                    </div>
                                    <span class="badge bg-secondary ms-2">
                                        {t.estado}
                                    </span>
                                </div>
                            ))
                        )
                    }
                </div>
            </div>
        </div>

        <!-- Panel 2: Tickets por Prioridad -->
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-body">
                    <h2 class="fs-6 fw-semibold m-0">Tickets por Prioridad</h2>
                </div>
                <div class="card-body d-flex flex-column gap-3">
                    {
                        stats.porPrioridad.length === 0 ? (
                            <p class="text-muted m-0">Sin prioridades</p>
                        ) : (
                            stats.porPrioridad.map((p, i) => (
                                <div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="fw-medium">{p.nombre}</span>
                                        <span class="fw-semibold">{p.count}</span>
                                    </div>
                                    <div class="progress" style="height: 8px">
                                        <div
                                            class={`progress-bar ${barColors[i % barColors.length]}`}
                                            style={`width: ${(p.count / maxPrioridad) * 100}%`}
                                        />
                                    </div>
                                </div>
                            ))
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</DashboardLayout>
