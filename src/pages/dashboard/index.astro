---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { Ticket, Clock, CircleCheck, Users } from "@lucide/astro";

// Datos de ejemplo para las tarjetas de resumen
const summaryCards = [
    {
        title: "Tickets Totales",
        value: "1,248",
        Icon: Ticket,
        color: "#0984e3",
    },
    { title: "Tickets Abiertos", value: "342", Icon: Clock, color: "#e17055" },
    {
        title: "Tickets Resueltos",
        value: "856",
        Icon: CircleCheck,
        color: "#00b894",
    },
    { title: "Usuarios Activos", value: "45", Icon: Users, color: "#6c5ce7" },
];

const prioridades = [
    { nombre: "Crítica", valor: 24, pct: 15, color: "bg-danger" },
    { nombre: "Alta", valor: 86, pct: 45, color: "bg-warning" },
    { nombre: "Media", valor: 142, pct: 75, color: "bg-primary" },
    { nombre: "Baja", valor: 90, pct: 50, color: "bg-success" },
];
---

<DashboardLayout pageTitle="Resumen General">
    <div class="row g-3 mb-4">
        {
            summaryCards.map((card) => (
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h3 class="small fw-medium text-muted m-0 mb-2">
                                    {card.title}
                                </h3>
                                <p class="fs-3 fw-bold m-0">{card.value}</p>
                            </div>
                            <div
                                class="d-flex align-items-center justify-content-center rounded"
                                style={`width: 48px; height: 48px; background-color: ${card.color}15; color: ${card.color};`}
                            >
                                <card.Icon width="24" height="24" stroke-width="2" />
                            </div>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>

    <div class="row g-3">
        <!-- Panel 1: Actividad Reciente -->
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div
                    class="card-header bg-white d-flex align-items-center justify-content-between"
                >
                    <h2 class="fs-6 fw-semibold m-0">Actividad Reciente</h2>
                    <a
                        href="/dashboard/tickets"
                        class="small text-primary text-decoration-none fw-medium"
                        >Ver todos</a
                    >
                </div>
                <div class="list-group list-group-flush">
                    {
                        [1, 2, 3, 4, 5].map((item, i) => (
                            <div class="list-group-item d-flex align-items-center px-3 py-3">
                                <div
                                    class="bg-light rounded d-flex align-items-center justify-content-center me-3 flex-shrink-0"
                                    style="width: 32px; height: 32px"
                                >
                                    <span class="small fw-bold text-secondary">
                                        US
                                    </span>
                                </div>
                                <div class="flex-grow-1" style="min-width: 0">
                                    <p class="fw-medium m-0 text-truncate">
                                        Usuario reportó un problema de conexión
                                    </p>
                                    <p class="small text-muted m-0">
                                        Ticket #104{i} • Hace {i * 10 + 5} minutos
                                    </p>
                                </div>
                                <span class="badge bg-warning text-dark ms-2">
                                    En Progreso
                                </span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- Panel 2: Tickets por Prioridad -->
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-white">
                    <h2 class="fs-6 fw-semibold m-0">Tickets por Prioridad</h2>
                </div>
                <div class="card-body d-flex flex-column gap-3">
                    {
                        prioridades.map((p) => (
                            <div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-medium">{p.nombre}</span>
                                    <span class="fw-semibold">{p.valor}</span>
                                </div>
                                <div class="progress" style="height: 8px">
                                    <div
                                        class={`progress-bar ${p.color}`}
                                        style={`width: ${p.pct}%`}
                                    />
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</DashboardLayout>
