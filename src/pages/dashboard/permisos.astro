---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { Plus, SquarePen } from "@lucide/astro";

// Datos simulados
const permisos = [
    {
        id: 1,
        nombre: "ticket:create",
        descripcion: "Permite crear nuevos tickets",
    },
    { id: 2, nombre: "ticket:read", descripcion: "Permite ver tickets" },
    {
        id: 3,
        nombre: "ticket:update",
        descripcion: "Permite modificar tickets existentes",
    },
    { id: 4, nombre: "ticket:delete", descripcion: "Permite eliminar tickets" },
    { id: 5, nombre: "user:manage", descripcion: "Permite gestionar usuarios" },
];
---

<DashboardLayout pageTitle="Gestión de Permisos">
    <div class="card">
        <div class="card-header bg-white d-flex align-items-center justify-content-end">
            <button class="btn btn-primary d-flex align-items-center gap-2">
                <Plus width="16" height="16" stroke-width="2" />
                Nuevo Permiso
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-uppercase small text-secondary">ID</th>
                        <th class="text-uppercase small text-secondary">Permiso</th>
                        <th class="text-uppercase small text-secondary">Descripción</th>
                        <th class="text-uppercase small text-secondary text-end">
                            Acciones
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {
                        permisos.map((permiso) => (
                            <tr>
                                <td class="text-secondary fw-medium">
                                    #{permiso.id}
                                </td>
                                <td>
                                    <code
                                        class="text-primary px-2 py-1 rounded"
                                        style="background-color: rgba(13, 110, 253, 0.1)"
                                    >
                                        {permiso.nombre}
                                    </code>
                                </td>
                                <td class="text-secondary">{permiso.descripcion}</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-link text-secondary p-1">
                                        <SquarePen width="18" height="18" stroke-width="2" />
                                    </button>
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </div>
</DashboardLayout>
