---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { Plus, SquarePen } from "@lucide/astro";

// Datos simulados
const roles = [
    {
        id: 1,
        nombre: "Administrador",
        descripcion: "Acceso total al sistema y configuraciones",
    },
    {
        id: 2,
        nombre: "Soporte",
        descripcion: "Puede ver y responder tickets asignados o generales",
    },
    {
        id: 3,
        nombre: "Cliente",
        descripcion: "Solo puede crear y ver sus propios tickets",
    },
];
---

<DashboardLayout pageTitle="Gestión de Roles">
    <div class="card">
        <!-- Toolbar -->
        <div class="card-header bg-white d-flex align-items-center justify-content-end">
            <button class="btn btn-primary d-flex align-items-center gap-2">
                <Plus width="16" height="16" stroke-width="2" />
                Nuevo Rol
            </button>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-uppercase small text-secondary">ID</th>
                        <th class="text-uppercase small text-secondary">Rol</th>
                        <th class="text-uppercase small text-secondary">Descripción</th>
                        <th class="text-uppercase small text-secondary text-end">
                            Acciones
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {
                        roles.map((rol) => (
                            <tr>
                                <td class="text-secondary fw-medium">#{rol.id}</td>
                                <td class="fw-semibold">{rol.nombre}</td>
                                <td class="text-secondary">{rol.descripcion}</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-link text-secondary p-1">
                                        <SquarePen width="18" height="18" stroke-width="2" />
                                    </button>
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </div>
</DashboardLayout>
