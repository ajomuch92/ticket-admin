---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { actions } from "astro:actions";
import CrudManager from "../../components/CrudManager.vue";

const [{ data: tickets }, { data: estados }, { data: prioridades }, { data: usuarios }] =
    await Promise.all([
        Astro.callAction(actions.tickets.list, {}),
        Astro.callAction(actions.estados.list, {}),
        Astro.callAction(actions.prioridades.list, {}),
        Astro.callAction(actions.usuarios.list, {}),
    ]);

const estadoOpts = (estados ?? []).map((e) => ({ value: e.id, label: e.nombre }));
const prioridadOpts = (prioridades ?? []).map((p) => ({ value: p.id, label: p.nombre }));
const usuarioOpts = (usuarios ?? []).map((u) => ({ value: u.id, label: u.nombre }));
---

<DashboardLayout pageTitle="Gestión de Tickets">
    <CrudManager
        client:load
        entity="tickets"
        titular="Ticket"
        plural="Tickets"
        initialItems={tickets ?? []}
        columns={[
            { key: "id", label: "ID" },
            { key: "titulo", label: "Título", truncate: 260 },
            { key: "estado.nombre", label: "Estado" },
            { key: "prioridad.nombre", label: "Prioridad" },
            { key: "creador.nombre", label: "Creador" },
            { key: "asignadoA.nombre", label: "Asignado a" },
        ]}
        fields={[
            { key: "titulo", label: "Título", type: "text", required: true },
            { key: "descripcion", label: "Descripción", type: "textarea" },
            {
                key: "estadoId",
                label: "Estado",
                type: "select-number",
                required: true,
                options: estadoOpts,
            },
            {
                key: "prioridadId",
                label: "Prioridad",
                type: "select-number",
                required: true,
                options: prioridadOpts,
            },
            {
                key: "creadorId",
                label: "Creador",
                type: "select-number",
                required: true,
                options: usuarioOpts,
            },
            {
                key: "asignadoAId",
                label: "Asignado a",
                type: "select-number",
                options: usuarioOpts,
            },
            { key: "fechaVencimiento", label: "Vence", type: "date" },
        ]}
    />
</DashboardLayout>
