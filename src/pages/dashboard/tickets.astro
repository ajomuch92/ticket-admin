---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { Search, Funnel, Plus, SquarePen, Trash2 } from "@lucide/astro";

// Datos simulados
const tickets = [
    {
        id: 1,
        titulo: "Error al cargar imagen de perfil",
        estado: "Abierto",
        estadoColor: "blue",
        prioridad: "Alta",
        prioridadColor: "orange",
        creador: "Juan Pérez",
        fecha: "2023-10-24 14:30",
    },
    {
        id: 2,
        titulo: "Actualizar dependencias del proyecto",
        estado: "En Progreso",
        estadoColor: "orange",
        prioridad: "Media",
        prioridadColor: "blue",
        creador: "María García",
        fecha: "2023-10-23 09:15",
    },
    {
        id: 3,
        titulo: "No puedo acceder al panel de admin",
        estado: "Cerrado",
        estadoColor: "gray",
        prioridad: "Crítica",
        prioridadColor: "red",
        creador: "Carlos López",
        fecha: "2023-10-22 16:45",
    },
    {
        id: 4,
        titulo: "Diseño roto en móvil",
        estado: "Resuelto",
        estadoColor: "green",
        prioridad: "Alta",
        prioridadColor: "orange",
        creador: "Ana Martínez",
        fecha: "2023-10-21 11:20",
    },
    {
        id: 5,
        titulo: "Exportar reporte a PDF",
        estado: "Abierto",
        estadoColor: "blue",
        prioridad: "Baja",
        prioridadColor: "green",
        creador: "Luis Rodríguez",
        fecha: "2023-10-20 10:05",
    },
];

const badgeClass = (c: string) =>
    ({
        blue: "bg-primary",
        orange: "bg-warning text-dark",
        green: "bg-success",
        red: "bg-danger",
        gray: "bg-secondary",
    })[c] ?? "bg-secondary";
---

<DashboardLayout pageTitle="Gestión de Tickets">
    <div class="card">
        <!-- Toolbar -->
        <div
            class="card-header bg-white d-flex align-items-center justify-content-between flex-wrap gap-3"
        >
            <div class="d-flex align-items-center gap-2">
                <div class="input-group" style="width: 250px">
                    <span class="input-group-text bg-white">
                        <Search width="16" height="16" stroke-width="2" />
                    </span>
                    <input
                        type="text"
                        class="form-control border-start-0 ps-0"
                        placeholder="Buscar tickets..."
                    />
                </div>
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2">
                    <Funnel width="16" height="16" stroke-width="2" />
                    Filtros
                </button>
            </div>

            <button class="btn btn-primary d-flex align-items-center gap-2">
                <Plus width="16" height="16" stroke-width="2" />
                Nuevo Ticket
            </button>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-uppercase small text-secondary">ID</th>
                        <th class="text-uppercase small text-secondary">Título</th>
                        <th class="text-uppercase small text-secondary">Estado</th>
                        <th class="text-uppercase small text-secondary">Prioridad</th>
                        <th class="text-uppercase small text-secondary">Creador</th>
                        <th class="text-uppercase small text-secondary">Fecha</th>
                        <th class="text-uppercase small text-secondary text-end">
                            Acciones
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {
                        tickets.map((ticket) => (
                            <tr>
                                <td class="text-secondary fw-medium">
                                    #{ticket.id}
                                </td>
                                <td class="fw-medium">{ticket.titulo}</td>
                                <td>
                                    <span class={`badge ${badgeClass(ticket.estadoColor)}`}>
                                        {ticket.estado}
                                    </span>
                                </td>
                                <td>
                                    <span class={`badge ${badgeClass(ticket.prioridadColor)}`}>
                                        {ticket.prioridad}
                                    </span>
                                </td>
                                <td class="text-secondary">{ticket.creador}</td>
                                <td class="text-secondary">{ticket.fecha}</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-link text-secondary p-1">
                                        <SquarePen width="18" height="18" stroke-width="2" />
                                    </button>
                                    <button class="btn btn-sm btn-link text-secondary p-1">
                                        <Trash2 width="18" height="18" stroke-width="2" />
                                    </button>
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div
            class="card-footer bg-white d-flex align-items-center justify-content-between flex-wrap gap-2"
        >
            <span class="small text-muted"
                >Mostrando <span class="fw-semibold text-dark">1</span> a <span
                    class="fw-semibold text-dark">5</span
                > de <span class="fw-semibold text-dark">1,248</span> tickets</span
            >
            <nav>
                <ul class="pagination pagination-sm m-0">
                    <li class="page-item disabled">
                        <span class="page-link">Anterior</span>
                    </li>
                    <li class="page-item active">
                        <span class="page-link">1</span>
                    </li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</DashboardLayout>
