---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { Search, Plus, SquarePen } from "@lucide/astro";

// Datos simulados
const usuarios = [
    {
        id: 1,
        nombre: "Admin User",
        email: "admin@ejemplo.com",
        rol: "Administrador",
        activo: true,
        fecha: "2023-01-15",
    },
    {
        id: 2,
        nombre: "Juan Pérez",
        email: "juan@ejemplo.com",
        rol: "Soporte",
        activo: true,
        fecha: "2023-02-20",
    },
    {
        id: 3,
        nombre: "María García",
        email: "maria@ejemplo.com",
        rol: "Cliente",
        activo: false,
        fecha: "2023-03-10",
    },
];
---

<DashboardLayout pageTitle="Gestión de Usuarios">
    <div class="card">
        <!-- Toolbar -->
        <div
            class="card-header bg-white d-flex align-items-center justify-content-between flex-wrap gap-3"
        >
            <div class="input-group" style="width: 250px">
                <span class="input-group-text bg-white">
                    <Search width="16" height="16" stroke-width="2" />
                </span>
                <input
                    type="text"
                    class="form-control border-start-0 ps-0"
                    placeholder="Buscar usuarios..."
                />
            </div>

            <button class="btn btn-primary d-flex align-items-center gap-2">
                <Plus width="16" height="16" stroke-width="2" />
                Nuevo Usuario
            </button>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-uppercase small text-secondary">ID</th>
                        <th class="text-uppercase small text-secondary">Usuario</th>
                        <th class="text-uppercase small text-secondary">Rol</th>
                        <th class="text-uppercase small text-secondary">Estado</th>
                        <th class="text-uppercase small text-secondary">Registro</th>
                        <th class="text-uppercase small text-secondary text-end">
                            Acciones
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {
                        usuarios.map((usuario) => (
                            <tr>
                                <td class="text-secondary fw-medium">
                                    #{usuario.id}
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div
                                            class="d-flex align-items-center justify-content-center rounded fw-bold text-primary flex-shrink-0"
                                            style="width: 36px; height: 36px; font-size: 14px; background-color: rgba(13, 110, 253, 0.1)"
                                        >
                                            {usuario.nombre.substring(0, 2).toUpperCase()}
                                        </div>
                                        <div class="d-flex flex-column">
                                            <span class="fw-medium">
                                                {usuario.nombre}
                                            </span>
                                            <span class="small text-muted">
                                                {usuario.email}
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-secondary">{usuario.rol}</td>
                                <td>
                                    {usuario.activo ? (
                                        <span class="badge bg-success">Activo</span>
                                    ) : (
                                        <span class="badge bg-secondary">Inactivo</span>
                                    )}
                                </td>
                                <td class="text-secondary">{usuario.fecha}</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-link text-secondary p-1">
                                        <SquarePen width="18" height="18" stroke-width="2" />
                                    </button>
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </div>
</DashboardLayout>
