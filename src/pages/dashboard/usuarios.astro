---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { actions } from "astro:actions";
import CrudManager from "../../components/CrudManager.vue";

const [{ data: usuarios }, { data: departamentos }] = await Promise.all([
    Astro.callAction(actions.usuarios.list, {}),
    Astro.callAction(actions.departamentos.list, {}),
]);
const departamentoOpts = (departamentos ?? []).map((d) => ({
    value: d.id,
    label: d.nombre,
}));
---

<DashboardLayout pageTitle="Gestión de Usuarios">
    <CrudManager
        client:load
        entity="usuarios"
        titular="Usuario"
        plural="Usuarios"
        initialItems={usuarios ?? []}
        columns={[
            { key: "id", label: "ID" },
            { key: "nombre", label: "Nombre" },
            { key: "email", label: "Email" },
            { key: "activo", label: "Activo", align: "center" },
        ]}
        fields={[
            { key: "nombre", label: "Nombre", type: "text", required: true },
            { key: "email", label: "Email", type: "text", required: true, lockOnEdit: true },
            {
                key: "password",
                label: "Contraseña",
                type: "password",
                required: true,
                hideOnEdit: true,
                generate: true,
            },
            {
                key: "departamentoId",
                label: "Departamento",
                type: "select-number",
                options: departamentoOpts,
            },
            { key: "activo", label: "Usuario activo", type: "checkbox" },
        ]}
        rowAction={{
            label: "Reset clave",
            actionName: "resetPassword",
            confirm: "¿Reestablecer la contraseña de este usuario a una aleatoria?",
            copyKey: "password",
            toastLabel: "Nueva contraseña (cópiala, no se vuelve a mostrar):",
        }}
    />
</DashboardLayout>
