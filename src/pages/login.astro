---
import Layout from "../layouts/Layout.astro";
import { Ticket } from "@lucide/astro";

// Lógica de sesión simulada
const action = Astro.url.searchParams.get("action");

if (action === "logout") {
    Astro.cookies.delete("session", { path: "/" });
    return Astro.redirect("/login");
}

if (Astro.request.method === "POST") {
    const data = await Astro.request.formData();
    const email = data.get("email");
    const password = data.get("password");

    if (email && password) {
        Astro.cookies.set("session", "true", { path: "/" });
        return Astro.redirect("/dashboard");
    }
}

if (Astro.cookies.has("session")) {
    return Astro.redirect("/dashboard");
}
---

<Layout title="Iniciar Sesión | Ticket Admin">
    <div class="min-h:100vh d:flex ai:center jc:center bg:gray-5 px:20">
        <div
            class="w:full max-w:400 bg:white r:8 shadow:0|4|12|rgba(0,0,0,0.05) border:1|solid|gray-10 overflow:hidden"
        >
            <div class="p:32">
                <div class="d:flex ai:center jc:center mb:24">
                    <Ticket
                        class="mr:8 text:#0984e3"
                        width="32"
                        height="32"
                        stroke-width="2"
                    />
                    <span class="font:24 font:bold text:gray-90"
                        >Ticket<span class="text:#0984e3">Admin</span></span
                    >
                </div>

                <h1
                    class="text:18 font:semibold text:gray-80 text:center mb:24 m:0"
                >
                    Iniciar Sesión
                </h1>

                <form method="POST" class="d:flex flex:col gap:16">
                    <div class="d:flex flex:col gap:6">
                        <label
                            for="email"
                            class="text:14 font:medium text:gray-70"
                            >Correo electrónico</label
                        >
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            placeholder="admin@ejemplo.com"
                            class="h:40 px:12 r:4 border:1|solid|gray-30 bg:white outline:none:focus border:#0984e3:focus shadow:0|0|0|3|rgba(9,132,227,0.1):focus transition:all|0.2s text:14 text:gray-90"
                        />
                    </div>

                    <div class="d:flex flex:col gap:6">
                        <div class="d:flex ai:center jc:space-between">
                            <label
                                for="password"
                                class="text:14 font:medium text:gray-70"
                                >Contraseña</label
                            >
                            <a
                                href="#"
                                class="text:12 text:#0984e3 text-decoration:none hover:text-decoration:underline"
                                >¿Olvidaste tu contraseña?</a
                            >
                        </div>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            placeholder="••••••••"
                            class="h:40 px:12 r:4 border:1|solid|gray-30 bg:white outline:none:focus border:#0984e3:focus shadow:0|0|0|3|rgba(9,132,227,0.1):focus transition:all|0.2s text:14 text:gray-90"
                        />
                    </div>

                    <button
                        type="submit"
                        class="mt:8 h:40 bg:#0984e3 color:white font:medium text:14 r:4 border:none cursor:pointer hover:bg:#0873c4 transition:bg|0.2s shadow:0|2|4|rgba(9,132,227,0.2)"
                    >
                        Entrar al sistema
                    </button>
                </form>
            </div>
            <div class="bg:gray-5 p:16 text:center border-t:1|solid|gray-10">
                <span class="text:13 text:gray-50"
                    >Para probar, ingresa cualquier correo y contraseña.</span
                >
            </div>
        </div>
    </div>
</Layout>
