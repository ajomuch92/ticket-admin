---
import Layout from "../layouts/Layout.astro";
import SoporteChat from "../components/SoporteChat.vue";
---

<Layout title="Reportar un problema | Ticket Admin">
    <div class="container py-4" style="max-width: 640px">
        <h1 class="fs-4 fw-semibold mb-1">Centro de Soporte</h1>
        <p class="text-muted mb-4">
            Chatea con nuestro asistente para reportar un problema. Recopilará tu
            nombre, correo y los detalles. Si deseas reportar un problema de otra forma, puedes enviarnos un correo a
            <a href="mailto:admin@ejemplo.com">admin@ejemplo.com</a>
        </p>
        <SoporteChat client:load />
    </div>
</Layout>
