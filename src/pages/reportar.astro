---
import Layout from "../layouts/Layout.astro";
import SoporteChat from "../components/SoporteChat.vue";
import { ArrowLeft } from "@lucide/astro";
import { issueChatToken } from "../lib/chatToken";

const chatToken = await issueChatToken();
---

<Layout title="Reportar un problema | Ticket Admin">
    <div class="container py-4" style="max-width: 640px">
        <div class="d-flex justify-content-between mb-3">
            <a
                href="/login"
                class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1"
            >
                <ArrowLeft width="16" height="16" stroke-width="2" />
                Volver al inicio de sesión
            </a>
            <a href="/buscar" class="btn btn-sm btn-outline-primary">
                Consultar un ticket
            </a>
        </div>
        <h1 class="fs-4 fw-semibold mb-1">Centro de Soporte</h1>
        <p class="text-muted mb-4">
            Chatea con nuestro asistente para reportar un problema. Recopilará tu
            nombre, correo y los detalles. Si deseas reportar un problema de otra forma, puedes enviarnos un correo a
            <a href="mailto:tickets_demo@hotmail.com">tickets_demo@hotmail.com</a>
        </p>
        <SoporteChat client:load token={chatToken} />
    </div>
</Layout>
